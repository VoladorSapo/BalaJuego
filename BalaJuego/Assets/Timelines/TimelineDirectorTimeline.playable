  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Hab\xE9is cometido un error viniendo hasta aqu\xED. Ninguno de vosotros
    saldr\xE1 con vida."
  dialogTexts:
  - "Hab\xE9is cometido un error viniendo hasta aqu\xED. Ninguno de vosotros saldr\xE1
    con vida."
  - 'You made a mistake coming here. None of you will leave alive.

'
  - "Heu com\xE8s un error venint fins aqu\xED. Cap de vosaltres en sortir\xE0 viu."
  leaveTime: 2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 6.9
  personaje: 0
  LanguageForEditor: 0
