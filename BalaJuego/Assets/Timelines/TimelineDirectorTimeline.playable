  m_EditorClassIdentifier: 
  dialogText: "Pero, hija, tu arma\u2026\r\nNo tiene ninguna bala.\r\n\n"
  dialogTexts:
  - "Pero, hija, tu arma\u2026\r\nNo tiene ninguna bala.\r"
  - 'But, daughter, your gun...

    It has no bullets.'
  - "Per\xF2, filla, la teva arma\u2026 \nNo t\xE9 cap bala."
  leaveTime: 1.6
