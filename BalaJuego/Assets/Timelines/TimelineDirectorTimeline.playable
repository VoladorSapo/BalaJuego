  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: 'Hemos rodeado el pueblo. Deja el arma en el suelo y ven con nosotros.

'
  dialogTexts:
  - 'Hemos rodeado el pueblo. Deja el arma en el suelo y ven con nosotros.

'
  - " We\u2019ve surrounded the town. Drop the gun and come with us."
  - "Hem envoltat el poble. Deixa l\u2019arma a terra i vine amb "
  leaveTime: 1.2
  startChars: 0
