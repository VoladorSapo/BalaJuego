  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Tranquilo, Padre, no tengo miedo. Usted me ha dicho que Dios est\xE1
    conmigo.\r\n"
  dialogTexts:
  - "Tranquilo, Padre, no tengo miedo. Usted me ha dicho que Dios est\xE1 conmigo.\r\n"
  - 'Calm down, Father, I am not afraid. You told me God is with me.

'
  - "Tranquil, Pare, no tinc por. Vost\xE8 m\u2019ha dit que D\xE9u \xE9s amb mi."
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 913.5
  personaje: 0
  LanguageForEditor: 0
