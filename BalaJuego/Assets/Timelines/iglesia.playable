  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: 'No vengo a confesar lo que ya he hecho, Padre.

'
  dialogTexts:
  - 'No vengo a confesar lo que ya he hecho, Padre.

'
  - "I\u2019m not here to confess what I\u2019ve already done, Father."
  - 'No vinc a confessar el que ja he fet, Pare.

'
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 1000
  personaje: 0
  LanguageForEditor: 0
--- !u!114 &-2961759890861426895
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
