  m_EditorClassIdentifier: 
  dialogText: "Hija m\xEDa, no cometas ninguna locura.\r\n"
  dialogTexts:
  - "Hija m\xEDa, no cometas ninguna locura.\r"
  - "My daughter, don\u2019t do anything foolish."
  - Filla meva, no facis cap bogeria.
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
