  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Pero ya te confesaste ayer, hija m\xEDa."
  dialogTexts:
  - "Pero ya te confesaste ayer, hija m\xEDa."
  - But you already confessed yesterday, my child.
  - "per\xF2 ja et vas confessar ahir, filla meva. \n"
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 1000
  personaje: 1
  LanguageForEditor: 0
--- !u!114 &-3779448723126467310
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
