--- !u!114 &-7579361408919524801
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "SAL DE UNA VEZ <nombre>. SABEMOS QUE EST\xC1S AH\xCD.\r\nVENIMOS A
    DARTE TU MERECIDO.\r\n"
  leaveTime: 1.6
  startChars: 46
  width: 913.5
--- !u!114 &-7012302857522422252
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: 
  dialogText: "Buenos d\xEDas, Padre. S\xE9 que acaba de amanecer, pero necesito
    confesarme.\r\n"
  leaveTime: 1.2
  startChars: 0
  width: 800
--- !u!114 &-6973001733160435521
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "No pod\xEDa dejar las cosas as\xED. Cuando me llegaron las noticias
    cog\xED mi rev\xF3lver y les segu\xED hasta un pueblo a las afueras. "
  leaveTime: 1.2
  startChars: 0
  width: 992.6
--- !u!114 &-6797685291095438895
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Pero le recuerdo que no est\xE1n permitidas las armas en el hogar
    del Se\xF1or.\r\n"
  leaveTime: 1.2
  startChars: 0
  width: 1000
--- !u!114 &-6375366669986874717
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Est\xE1n en busca de unos rev\xF3lveres con unas habilidades poderosas,
    iguales al de mi marido y al m\xEDo."
  leaveTime: 1.2
  startChars: 0
  width: 992.6
