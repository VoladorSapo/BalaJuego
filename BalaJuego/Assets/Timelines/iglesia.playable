  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "\xC9l tuvo la mala suerte de ir en esa diligencia.\r\n"
  dialogTexts:
  - "\xC9l tuvo la mala suerte de ir en esa diligencia.\r\n"
  - 'He was unlucky enough to be on that stagecoach.

'
  - "Ell va tenir la mala sort d\u2019anar en aquella dilig\xE8ncia."
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 992.6
  personaje: 0
  LanguageForEditor: 0
