--- !u!114 &-5602929870455056346
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Mi m\xE1s sincero p\xE9same,  hija.\nPuedo asegurarte que Dios est\xE1
    contigo."
  dialogTexts:
  - "Mi m\xE1s sincero p\xE9same,  hija.\nPuedo asegurarte que Dios est\xE1 contigo."
  - My deepest condolences, daughter. I can assure you God is with you.
  - "El meu m\xE9s sincer condol, filla. Et puc assegurar que D\xE9u \xE9s amb tu."
  leaveTime: 1.2
  startChars: 29
  startCharsList: 1d0000002100000020000000
  width: 1064.63
  personaje: 1
  LanguageForEditor: 0
