--- !u!114 &-7579361408919524801
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "SAL DE UNA VEZ AGATHA. SABEMOS QUE EST\xC1S AH\xCD.\r\nVENIMOS A DARTE
    TU MERECIDO.\r\n"
  dialogTexts:
  - "SAL DE UNA VEZ AGATHA. SABEMOS QUE EST\xC1S AH\xCD.\r\nVENIMOS A DARTE TU MERECIDO.\r\n"
  - "GET OUT ALREADY, AGATHA. WE KNOW YOU\u2019RE IN THERE. WE\u2019VE COME TO GIVE
    YOU WHAT YOU DESERVE."
  - "SURT D\u2019UNA VEGADA, AGATHA. SABEM QUE HI ETS. HEM VINGUT A DONAR-TE EL QUE
    ET MEREIXES."
  leaveTime: 1.6
  startChars: 46
  startCharsList: 2e000000310000002c000000
  width: 913.5
  personaje: 0
  LanguageForEditor: 0
--- !u!114 &-7012302857522422252
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip
  m_EditorClassIdentifier: 
  dialogText: "Buenos d\xEDas, Padre. S\xE9 que acaba de amanecer, pero necesito
    confesarme.\r\n"
  dialogTexts:
  - "Buenos d\xEDas, Padre. S\xE9 que acaba de amanecer, pero necesito confesarme.\r\n"
  - Good morning, Father. I know it's just dawn, but I need to confess.
  - "Bon dia, Pare. S\xE9 que tot just \xE9s l\u2019alba, per\xF2 necessito confessar-me."
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 800
  personaje: 0
  LanguageForEditor: 0
--- !u!114 &-6973001733160435521
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "No pod\xEDa dejar las cosas as\xED. Cuando me llegaron las noticias
    cog\xED mi rev\xF3lver y les segu\xED hasta un pueblo a las afueras. "
  dialogTexts:
  - "No pod\xEDa dejar las cosas as\xED. Cuando me llegaron las noticias cog\xED
    mi rev\xF3lver y les segu\xED hasta un pueblo a las afueras. "
  - "I couldn\u2019t leave things like that. When the news reached me I grabbed my
    revolver and followed them to a nearby village."
  - "No podia deixar les coses aix\xED. Quan em van arribar les not\xEDcies vaig
    agafar el meu rev\xF2lver i els vaig seguir fins a un poble a les afores"
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 992.6
  personaje: 0
  LanguageForEditor: 0
--- !u!114 &-6797685291095438895
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Pero le recuerdo que no est\xE1n permitidas las armas en el hogar
    del Se\xF1or.\r\n"
  dialogTexts:
  - "Pero le recuerdo que no est\xE1n permitidas las armas en el hogar del Se\xF1or.\r\n"
  - "But I remind you that weapons are not allowed in the Lord\u2019s house.\r\n"
  - "Per\xF2 et recordo que les armes no estan permeses a la casa del Senyor.\r\n"
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 1000
  personaje: 1
  LanguageForEditor: 0
--- !u!114 &-6375366669986874717
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Est\xE1n en busca de unos rev\xF3lveres con unas habilidades poderosas,
    iguales al de mi marido y al m\xEDo."
  dialogTexts:
  - "Est\xE1n en busca de unos rev\xF3lveres con unas habilidades poderosas, iguales
    al de mi marido y al m\xEDo."
  - "They\u2019re looking for some revolvers with powerful abilities, the same as
    my husband\u2019s and mine.\r\n"
  - "Busquen uns rev\xF2lvers amb habilitats poderoses, iguals als del meu marit
    i al meu.\r\n"
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 992.6
  personaje: 0
  LanguageForEditor: 0
