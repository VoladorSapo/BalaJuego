--- !u!114 &-1205461654746776039
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Cu\xE9ntame, hija. \nCu\xE9ntame y se te perdonar\xE1. \r\n"
  dialogTexts:
  - "Cu\xE9ntame, hija. \nCu\xE9ntame y se te perdonar\xE1. \r\n"
  - Tell me, daughter. Tell me and you will be forgiven.
  - "Explica-m\u2019ho, filla.\nExplica-m\u2019ho i ser\xE0s perdonada."
  leaveTime: 1.2
  startChars: 13
  startCharsList: 0d0000001200000014000000
  width: 900
  personaje: 1
  LanguageForEditor: 0
