  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Hace unos d\xEDas los hombres de Antperton asaltaron una diligencia
    en las afueras. "
  dialogTexts:
  - "Hace unos d\xEDas los hombres de Antperton asaltaron una diligencia en las afueras. "
  - ' A few days ago the men from Antperton robbed a stagecoach outside of town.

'
  - "Fa uns dies els homes d\u2019Antperton van assaltar una dilig\xE8ncia a les
    afores."
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 800
  personaje: 0
  LanguageForEditor: 0
--- !u!114 &1224783452261815374
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
