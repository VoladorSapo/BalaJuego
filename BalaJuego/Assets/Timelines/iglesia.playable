  m_Script: {fileID: 11500000, guid: edc63693dd854f54780d8b7b6cc934dd, type: 3}
  m_Name: DialogueClip(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)(Clone)
  m_EditorClassIdentifier: 
  dialogText: "Hice una masacre, Padre, no qued\xF3 ni uno solo de ellos en pie. "
  dialogTexts:
  - "Hice una masacre, Padre, no qued\xF3 ni uno solo de ellos en pie. "
  - "I made a massacre, Father, there wasn\u2019t a single one of them left standing.\r\n"
  - 'Vaig fer una massacre, Pare, no en va quedar ni un sol dret.

'
  leaveTime: 1.2
  startChars: 0
  startCharsList: 000000000000000000000000
  width: 992.6
  personaje: 0
  LanguageForEditor: 0
